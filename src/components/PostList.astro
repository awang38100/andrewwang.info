---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: CollectionEntry<'writing'>[];
}

const { posts } = Astro.props;
---

<ul class="item-list">
  {
    posts.map((post) => (
      <li>
        <a class="item-title" href={`/writing/${post.id}/`}>
          {post.data.title}
        </a>
        {post.data.draft && <span class="badge">draft</span>}
        <div class="item-meta">
          <FormattedDate date={post.data.date} /> · {post.data.description}
        </div>
      </li>
    ))
  }
</ul>
