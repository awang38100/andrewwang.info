---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { getPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';
import { AUTHOR } from '../consts';

const recentPosts = (await getPosts()).slice(0, 5);
const selectedProjects = (await getProjects()).slice(0, 3);
---

<BaseLayout>
  <section class="bio">
    <p>
      I'm <b>{AUTHOR.name}</b>. I build AI Products and Solutions at Citadel in NYC.
    </p>
    <p>
      Previously, I spent two years as a consultant at BCG and studied Electrical Engineering &amp; Computer Science and
      Economics at Yale.
    </p>
    <p>
      Feel free to reach me at{' '}
      <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>.
    </p>
  </section>

  <section>
    <h2 class="section-heading">Selected Projects</h2>
    <ProjectList projects={selectedProjects} />
    <p><a href="/projects/">All projects →</a></p>
  </section>

  <section>
    <h2 class="section-heading">Recent Writing</h2>
    {recentPosts.length > 0 ? <PostList posts={recentPosts} /> : <p class="muted">Nothing here yet.</p>}
    <p><a href="/writing/">All writing →</a></p>
  </section>
</BaseLayout>
