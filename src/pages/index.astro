---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import { getPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';
import { AUTHOR } from '../consts';

const posts = await getPosts();
const selectedProjects = (await getProjects()).slice(0, 3);
---

<BaseLayout>
  <section class="bio">
    <p>
      I'm <b>{AUTHOR.name}</b>. I build AI products and solutions at Citadel.
    </p>
    <p>
      Previously, I was a BCG consultant and studied Electrical Engineering &amp; Computer Science and
      Economics at Yale.
    </p>
    <p>
      Feel free to reach me at{' '}
      <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>.
    </p>
  </section>

  {
    selectedProjects.length > 0 && (
      <section>
        <h2 class="section-heading">Selected Projects</h2>
        <ProjectList projects={selectedProjects} />
        <p>
          <a href="/projects/">All projects →</a>
        </p>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section>
        <h2 class="section-heading">Writings</h2>
        <PostList posts={posts} />
      </section>
    )
  }
</BaseLayout>
