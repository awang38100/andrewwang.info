---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Things I've built and am building." noindex={projects.length === 0}>
  <h1>Projects</h1>
  <p class="muted">Things I've built and am building.</p>
  {projects.length > 0 ? <ProjectList projects={projects} /> : <p class="muted">Nothing here yet.</p>}
</BaseLayout>
